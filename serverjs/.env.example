# PostgreSQL connection string used by the Express server.
DB_URL=postgresql://username:password@localhost:5432/database_name

# Prisma currently uses SQLite in client/prisma/schema.prisma.
# Set this if you run Prisma commands from the client directory.
DATABASE_URL=file:./dev.db

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
IMG_UPLOAD_PRESET=your_cloudinary_image_upload_preset

MAIL_EMAIL=your_email_address
MAIL_PASSWORD=your_email_app_password
JWT_SECRET=replace_with_a_long_random_secret
